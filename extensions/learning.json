{
  "id": "pseudostudio.learning", "name": "Laboratorio de algoritmos", "version": "1.0.0", "author": "PseudoStudio", "description": "Plantillas de suma, intercambio y recorrido de arreglos para practicar.", "themes": [],
  "snippets": [
    { "prefix": "intercambiar", "body": "${1:auxiliar} <- ${2:a}\n${2:a} <- ${3:b}\n${3:b} <- ${1:auxiliar}", "description": "Intercambiar dos valores" },
    { "prefix": "acumular", "body": "${1:suma} <- 0\nPara ${2:i} <- 1 Hasta ${3:n} Hacer\n\t${1:suma} <- ${1:suma} + ${2:i}\nFinPara", "description": "Acumular una suma" },
    { "prefix": "recorrer", "body": "Para ${1:i} <- 1 Hasta ${2:n} Hacer\n\tEscribir ${3:arreglo}[${1:i}]\nFinPara", "description": "Recorrer un arreglo en base 1" }
  ]
}
